###############################################################
# 9. GET Answer Key - Code 101
###############################################################
### GET Answer Key 101
GET {{baseUrl}}/exams/{{examId}}/codes/{{codeId101}}/answer-key
Authorization: Bearer {{teacherAccessToken}}


###############################################################
# 10. Publish Exam
###############################################################
### POST Publish Exam
POST {{baseUrl}}/exams/{{examId}}/publish
Authorization: Bearer {{teacherAccessToken}}


###############################################################
# 11. Try to update questionCount after publish (should fail)
###############################################################
### PATCH questionCount after publish - should 409
PATCH {{baseUrl}}/exams/{{examId}}
Authorization: Bearer {{teacherAccessToken}}
Content-Type: application/json

{
  "questionCount": 50
}


###############################################################
# 12. Close Exam
###############################################################
### POST Close Exam
POST {{baseUrl}}/exams/{{examId}}/close
Authorization: Bearer {{teacherAccessToken}}


###############################################################
# 13. Archive Exam
###############################################################
### POST Archive Exam
POST {{baseUrl}}/exams/{{examId}}/archive
Authorization: Bearer {{teacherAccessToken}}


###############################################################
# 14. Delete Exam (only DRAFT allowed)
###############################################################
### DELETE Exam
DELETE {{baseUrl}}/exams/{{examId}}
Authorization: Bearer {{teacherAccessToken}}


###############################################################
# 15. Student access exam (should 403)
###############################################################
### GET Exams as STUDENT - should 403
# (Dung student access token neu co)
GET {{baseUrl}}/exams
Authorization: Bearer STUDENT_ACCESS_TOKEN_HERE