generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS - Auth
// =====================================================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

// =====================================================
// ENUMS - Exam
// =====================================================

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum ScoringType {
  EQUAL
  CUSTOM
}

enum AnswerOption {
  A
  B
  C
  D
}

// =====================================================
// ENUMS - Submission
// =====================================================

enum ExamSubmissionStatus {
  PROVISIONAL
  FINAL
}

enum SubmissionAnswerOutcome {
  CORRECT
  INCORRECT
  BLANK
  INVALID_MULTIPLE
  UNRESOLVED
}

enum TeacherReviewResolution {
  ANSWER
  BLANK
  MULTIPLE_INVALID
  UNRESOLVED
}

enum SubmissionAuditEventType {
  SUBMISSION_CREATED
  ANSWER_REVIEWED
  IDENTITY_REVIEWED
  REGRADED
}

// =====================================================
// ENUMS - Publication
// =====================================================

enum ResultPublicationAction {
  PUBLISHED
  UNPUBLISHED
}

// =====================================================
// AUTH MODELS
// =====================================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  teacher       Teacher?
  student       Student?
  refreshTokens RefreshToken[]

  submissionsGraded           ExamSubmission[]         @relation("SubmissionsGraded")
  submissionsIdentityReviewed ExamSubmission[]         @relation("SubmissionsIdentityReviewed")
  submissionAnswersReviewed   SubmissionAnswer[]       @relation("SubmissionAnswersReviewed")
  submissionAuditLogs         ExamSubmissionAuditLog[] @relation("SubmissionAuditLogs")
  examsPublished              Exam[]                   @relation("ExamResultPublisher")
  resultPublicationLogs       ExamResultPublicationLog[] @relation("PublicationLogActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

// =====================================================
// SCHOOL MODELS
// =====================================================

model Teacher {
  id          String  @id @default(cuid())
  userId      String  @unique
  teacherCode String  @unique
  fullName    String
  phone       String?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeachingAssignment[]
  exams       Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id          String    @id @default(cuid())
  userId      String    @unique
  studentCode String    @unique
  fullName    String
  dateOfBirth DateTime?
  initialPassword String? @default("123456")

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]
  candidates  ExamCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AcademicYear {
  id        String    @id @default(cuid())
  name      String    @unique
  startDate DateTime?
  endDate   DateTime?

  semesters   Semester[]
  classes     Class[]
  enrollments StudentEnrollment[]
  assignments TeachingAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Semester {
  id             String @id @default(cuid())
  name           String
  academicYearId String

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  startDate DateTime?
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([academicYearId, name])
  @@index([academicYearId])
}

model Grade {
  id    String @id @default(cuid())
  level Int    @unique
  name  String @unique

  classes Class[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id             String @id @default(cuid())
  name           String
  gradeId        String
  academicYearId String

  grade        Grade        @relation(fields: [gradeId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  enrollments StudentEnrollment[]
  assignments TeachingAssignment[]
  exams       Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, academicYearId])
  @@index([gradeId])
  @@index([academicYearId])
}

model StudentEnrollment {
  id             String @id @default(cuid())
  studentId      String
  classId        String
  academicYearId String

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([classId])
  @@index([academicYearId])
}

model Subject {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String  @unique
  description String?

  assignments TeachingAssignment[]
  exams       Exam[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeachingAssignment {
  id             String @id @default(cuid())
  teacherId      String
  classId        String
  subjectId      String
  academicYearId String

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, classId, subjectId, academicYearId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
  @@index([academicYearId])
}

// =====================================================
// EXAM MODELS
// =====================================================

model Exam {
  id          String  @id @default(cuid())
  title       String
  description String?

  teacherId String
  subjectId String
  classId   String

  questionCount Int
  maxScore      Decimal     @db.Decimal(6, 4)
  scoringType   ScoringType @default(EQUAL)

  status      ExamStatus @default(DRAFT)
  publishedAt DateTime?

  allowStudentViewAnswers Boolean @default(false)
  allowStudentViewImage   Boolean @default(false)

  // Result Publication (Phase 8)
  resultsPublishedAt         DateTime?
  resultsPublishedByUserId   String?

  teacher              Teacher               @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject              Subject               @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  class                Class                 @relation(fields: [classId], references: [id], onDelete: Restrict)
  resultsPublishedByUser User?               @relation("ExamResultPublisher", fields: [resultsPublishedByUserId], references: [id], onDelete: SetNull)
  examCodes            ExamCode[]
  answerSheetTemplates AnswerSheetTemplate[]
  submissions          ExamSubmission[]
  publicationLogs      ExamResultPublicationLog[]
  candidates           ExamCandidate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@index([status])
}

model ExamCode {
  id     String @id @default(cuid())
  examId String
  code   String

  exam        Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  answerKeys  AnswerKey[]
  submissions ExamSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, code])
  @@index([examId])
}

model AnswerKey {
  id             String       @id @default(cuid())
  examCodeId     String
  questionNumber Int
  correctAnswer  AnswerOption
  score          Decimal      @db.Decimal(6, 4)

  examCode ExamCode @relation(fields: [examCodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examCodeId, questionNumber])
  @@index([examCodeId])
}

model AnswerSheetTemplate {
  id                  String @id @default(cuid())
  examId              String
  version             Int    @default(1)
  templateVersion     String @default("OMR_V1")
  studentNumberDigits Int    @default(6)
  examCodeDigits      Int    @default(3)
  questionsPerPage    Int    @default(50)
  pageCount           Int    @default(1)
  layoutJson          Json

  exam        Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  submissions ExamSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, version])
  @@index([examId])
}

// =====================================================
// SUBMISSION MODELS
// =====================================================

model ExamSubmission {
  id                    String               @id @default(cuid())
  examId                String
  examCodeId            String
  answerSheetTemplateId String
  gradedByUserId        String
  status                ExamSubmissionStatus @default(PROVISIONAL)

  // Original Identity Observation
  detectedStudentNumber  String?
  candidateStudentNumber String?
  studentNumberOmrStatus String

  // Current Identity State
  resolvedStudentNumber    String?
  identityNeedsReview      Boolean   @default(false)
  identityReviewedByUserId String?
  identityReviewedAt       DateTime?

  // Image Metadata
  originalImageStorageKey String
  originalImageSha256     String
  originalImageMimeType   String
  originalImageSizeBytes   Int
  originalImageWidth      Int?
  originalImageHeight     Int?

  // OMR Metadata
  omrOverallStatus String
  templateVersion  String?
  qualityMetadata  Json?
  timingMetadata   Json?
  rawOmrSnapshot   Json?

  // Grading Configuration Snapshots
  questionCountSnapshot Int
  maxScoreSnapshot      Decimal     @db.Decimal(6, 4)
  scoringTypeSnapshot   ScoringType
  examCodeSnapshot      String

  // Grading Summary
  correctCount     Int
  incorrectCount   Int
  blankCount       Int
  unresolvedCount  Int
  provisionalScore Decimal? @db.Decimal(6, 4)
  finalScore       Decimal? @db.Decimal(6, 4)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finalizedAt DateTime?

  // Relations
  exam                   Exam                   @relation(fields: [examId], references: [id], onDelete: Restrict)
  examCode               ExamCode               @relation(fields: [examCodeId], references: [id], onDelete: Restrict)
  template               AnswerSheetTemplate    @relation(fields: [answerSheetTemplateId], references: [id], onDelete: Restrict)
  gradedByUser           User                   @relation("SubmissionsGraded", fields: [gradedByUserId], references: [id], onDelete: Restrict)
  identityReviewedByUser User?                  @relation("SubmissionsIdentityReviewed", fields: [identityReviewedByUserId], references: [id], onDelete: Restrict)
  answers                SubmissionAnswer[]
  auditLogs              ExamSubmissionAuditLog[]

  @@unique([examId, originalImageSha256])
  @@index([examId])
  @@index([examCodeId])
  @@index([status])
  @@index([gradedByUserId])
}

model SubmissionAnswer {
  id             String @id @default(cuid())
  submissionId   String
  questionNumber Int

  // Original OMR - Immutable
  detectedAnswer       String?
  candidate            String?
  originalCandidates   Json?
  omrStatus            String
  confidence           Float
  fillRatios           Json
  reviewCropStorageKey String?

  // Answer Key Snapshot
  correctAnswerSnapshot AnswerOption
  scoreSnapshot         Decimal      @db.Decimal(6, 4)

  // Teacher Review
  resolvedByTeacher Boolean                   @default(false)
  teacherResolution TeacherReviewResolution?
  resolvedAnswer    String?
  reviewedByUserId  String?
  reviewedAt        DateTime?

  // Current Derived Outcome
  effectiveAnswer String?
  result          SubmissionAnswerOutcome
  scoreEarned     Decimal?                 @db.Decimal(6, 4)
  needsReview     Boolean                  @default(false)

  // Relations
  submission     ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewedByUser User?          @relation("SubmissionAnswersReviewed", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@unique([submissionId, questionNumber])
  @@index([submissionId])
}

model ExamSubmissionAuditLog {
  id             String                   @id @default(cuid())
  submissionId   String
  actorUserId    String
  eventType      SubmissionAuditEventType
  questionNumber Int?
  beforeState    Json?
  afterState     Json?
  reason         String?
  createdAt      DateTime                 @default(now())

  // Relations
  submission ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorUser  User           @relation("SubmissionAuditLogs", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([submissionId, createdAt])
  @@index([actorUserId])
}

// =====================================================
// PUBLICATION MODELS
// =====================================================

model ExamResultPublicationLog {
  id          String                  @id @default(cuid())
  examId      String
  actorUserId String
  action      ResultPublicationAction
  note        String?
  createdAt   DateTime                @default(now())

  // Relations
  exam      Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  actorUser User @relation("PublicationLogActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([examId, createdAt])
  @@index([actorUserId])
}

// =====================================================
// CANDIDATE MAPPING MODELS (Phase 9)
// =====================================================

model ExamCandidate {
  id            String   @id @default(cuid())
  examId        String
  studentId     String
  studentNumber String

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
  @@unique([examId, studentNumber])
  @@index([examId])
  @@index([studentId])
}
